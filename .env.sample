FRONTEND_PORT=3000
SERVER_PORT=8080

FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:8080

POSTGRES_DB=staysmartdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_postgres_password

DB_URL=jdbc:postgresql://localhost:5432/staysmartdb
DB_USERNAME=postgres
DB_PASSWORD=change_me_postgres_password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_ACCESS_SECRET=change_me_access_secret_32_chars_minimum
JWT_REFRESH_SECRET=change_me_refresh_secret_32_chars_minimum
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

ADMIN_EMAIL=admin@staysmart.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin_password

VITE_TURNSTILE_SITE_KEY=0x0000000000000000000000
TURNSTILE_SECRET_KEY=0x0000000000000000000000
TURNSTILE_VERIFY_URL=https://challenges.cloudflare.com/turnstile/v0/siteverify

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_FOLDER=stay-smart

MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=false
MAIL_SMTP_SSL_ENABLE=true
MAIL_CONNECTION_TIMEOUT=10000
MAIL_TIMEOUT=10000
MAIL_WRITE_TIMEOUT=10000

SPRINGDOC_API_DOCS_PATH=/v3/api-docs
SPRINGDOC_API_DOCS_VERSION=OPENAPI_3_0
SPRINGDOC_SWAGGER_UI_PATH=/swagger-ui
